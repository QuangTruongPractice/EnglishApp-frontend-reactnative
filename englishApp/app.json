{
  "expo": {
    "name": "EnglishApp",
    "slug": "englishApp",
    "version": "1.0.0",
    "owner": "truongtranquang91",
    "orientation": "portrait",
    "icon": "./assets/logo-image.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-image.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "SCHEDULE_EXACT_ALARM"
      ],
      "package": "com.truongtranquang91.englishApp"
    },
    "web": {
      "favicon": "./assets/logo-image.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "749b1c30-c986-45f8-8462-992d7207fdb0"
      }
    }
  }
}
